<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ImageViewer"
           Manufacturer="ImageViewer"
           Version="$(var.Version)"
           UpgradeCode="8A7D39D4-6E2F-4C8E-9A51-3E7C89E4A102"
           Scope="perUser"
           Language="1042"
           Codepage="65001"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="ImageViewer 설치 패키지"
                        Manufacturer="ImageViewer" />

    <MajorUpgrade DowngradeErrorMessage="더 새로운 버전의 [ProductName] 이(가) 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(sys.SOURCEFILEDIR)..\ImageViewer\Resources\ImageViewer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/edith2580/ImageViewer" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ImageViewer" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="ImageViewer" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcutsAndRegistry" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="AppShortcutsAndRegistry"
               Directory="INSTALLFOLDER"
               Guid="C4B9E2A1-5F38-4D12-8E7A-9B0C1D2E3F4A">
      <Shortcut Id="StartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="ImageViewer"
                Target="[INSTALLFOLDER]ImageViewer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />

      <RemoveFolder Id="CleanInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="CleanProgramsDir" Directory="ProgramsDir" On="uninstall" />

      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\ImageViewer"
                     Name="InstallLocation"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>

    <!-- 설치 완료 시 탐색기 우클릭 메뉴 등록, 제거 시 해제 -->
    <CustomAction Id="RegisterShellMenu"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]ImageViewer.exe&quot; --register-shell"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="UnregisterShellMenu"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]ImageViewer.exe&quot; --unregister-shell"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterShellMenu" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="UnregisterShellMenu" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
