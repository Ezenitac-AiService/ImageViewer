<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImageViewer.ViewModels"
        xmlns:models="clr-namespace:ImageViewer.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Icon="/Resources/ImageViewer.ico"
        Width="1280" Height="800" MinWidth="480" MinHeight="320"
        Background="{StaticResource PanelBackground}"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        MouseLeave="OnWindowMouseLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnClosing"
        StateChanged="OnWindowStateChanged"
        DpiChanged="OnDpiChanged">

    <!-- 기본 제목 표시줄 없이 크기 조절 · 스냅 · 그림자만 유지한다 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Q" Command="{Binding ExitCommand}" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">

        <!-- 이미지 표시 영역: 창 전체를 채우고, 상단 바 · 하단 바는 그 위에 겹쳐 표시한다. -->
        <Grid x:Name="Viewport"
              Focusable="True" FocusVisualStyle="{x:Null}"
              ClipToBounds="True"
              Background="{Binding Background, Converter={StaticResource BackgroundToBrush}}"
              SizeChanged="OnViewportSizeChanged"
              PreviewMouseWheel="OnViewportMouseWheel"
              MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
              MouseUp="OnViewportMouseUp"
              MouseMove="OnViewportMouseMove"
              MouseDown="OnViewportMouseDown"
              LostMouseCapture="OnViewportLostMouseCapture">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="이전 이미지" InputGestureText="←" Command="{Binding PreviousCommand}" />
                    <MenuItem Header="다음 이미지" InputGestureText="→" Command="{Binding NextCommand}" />
                    <MenuItem Header="이미지 목록" InputGestureText="Enter" Command="{Binding ShowImageListCommand}" />
                    <Separator />
                    <MenuItem Header="원본 크기" InputGestureText="0" Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.Original}"
                              IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Original}" />
                    <MenuItem Header="폭 맞춤" InputGestureText="7" Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.FitWidth}"
                              IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FitWidth}" />
                    <MenuItem Header="높이 맞춤" InputGestureText="8" Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.FitHeight}"
                              IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FitHeight}" />
                    <MenuItem Header="꽉 차게 보기" InputGestureText="9" Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.Fill}"
                              IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Fill}" />
                    <Separator />
                    <MenuItem Header="시계 방향 회전" InputGestureText="R" Command="{Binding RotateClockwiseCommand}" />
                    <MenuItem Header="반시계 방향 회전" InputGestureText="L" Command="{Binding RotateCounterClockwiseCommand}" />
                    <MenuItem Header="좌우 반전" InputGestureText="H" Command="{Binding FlipHorizontalCommand}" />
                    <MenuItem Header="상하 반전" InputGestureText="V" Command="{Binding FlipVerticalCommand}" />
                    <MenuItem Header="이미지 정보" InputGestureText="Tab" Command="{Binding ToggleInfoPanelCommand}"
                              IsChecked="{Binding IsInfoPanelVisible, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="슬라이드쇼 재생 / 일시정지" InputGestureText="Space" Command="{Binding ToggleSlideShowCommand}"
                              IsChecked="{Binding IsSlideShowPlaying, Mode=OneWay}" />
                    <MenuItem Header="상단 · 하단 바 고정" InputGestureText="`" Command="{Binding ToggleMenusCommand}"
                              IsChecked="{Binding BothBarsPinned, Mode=OneWay}" />
                    <MenuItem Header="전체 화면" InputGestureText="Alt+Enter" Command="{Binding ToggleFullScreenCommand}"
                              IsChecked="{Binding IsFullScreen, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="종료" InputGestureText="Esc" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Canvas x:Name="ImageCanvas">
                <Image x:Name="DisplayImage"
                       Source="{Binding CurrentBitmap}"
                       Width="{Binding DisplayWidth}"
                       Height="{Binding DisplayHeight}"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Canvas>

            <TextBlock Text="{Binding PlaceholderMessage}"
                       Visibility="{Binding PlaceholderMessage, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{Binding Background, Converter={StaticResource BackgroundToForeground}}"
                       FontSize="16" TextAlignment="Center" TextWrapping="Wrap" LineHeight="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />

            <Border Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}"
                    Background="#CC2A1A1A" BorderBrush="#FF8A3A3A" BorderThickness="1" CornerRadius="6"
                    Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                <StackPanel>
                    <TextBlock Text="⚠ 이미지를 표시할 수 없습니다" Foreground="#FFFF9A9A" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFE8E8E8" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="← → 키로 다른 이미지로 이동할 수 있습니다." Foreground="#FFA0A0A0"
                               HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="11" />
                </StackPanel>
            </Border>

            <!-- 이미지 정보(EXIF) 패널: Tab 으로 여닫는다. 위치는 상단 바 높이에 맞춰 코드에서 조정 -->
            <Border x:Name="InfoPanel"
                    Visibility="{Binding IsInfoPanelVisible, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                    MaxWidth="380" Padding="14,4,14,10" CornerRadius="10"
                    Background="#D91B1B1E" BorderBrush="#30FFFFFF" BorderThickness="1"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" />
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding InfoItems}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="#FF9AA3AD" FontSize="12"
                                           Margin="0,1,14,1" />
                                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" Foreground="#FFEDEDED"
                                           FontSize="12" Margin="0,1" TextWrapping="Wrap" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="#FF7DB4FF" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Label" Property="Margin" Value="0,8,0,3" />
                                    <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 프레임 · 페이지 정보: 애니메이션(GIF / WebP) 과 다중 페이지 이미지에서 왼쪽 아래에 반투명하게 표시.
                 하단 바가 보일 때는 그 위로 올린다 (코드에서 위치 조정) -->
            <Border x:Name="FrameInfo"
                    Visibility="{Binding FrameInfoText, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,14"
                    Background="#8C000000" CornerRadius="8" Padding="12,6,12,7"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding FrameInfoText}" Foreground="#E6FFFFFF" FontSize="12" LineHeight="19"
                           Typography.NumeralAlignment="Tabular" />
            </Border>

            <!-- 상태 알림 (OSD) -->
            <Border Visibility="{Binding OsdMessage, Converter={StaticResource BoolToVisibility}}"
                    Background="#C0000000" CornerRadius="4" Padding="14,6"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                    IsHitTestVisible="False">
                <TextBlock Text="{Binding OsdMessage}" Foreground="White" FontSize="14" />
            </Border>

            <!-- 로딩 게이지: 화면 가운데 회전하는 원호. 디코딩 진행률은 알 수 없으므로 진행 중 표시만 한다.
                 (짧은 로딩에는 나타나지 않도록 ViewModel 에서 250ms 뒤에 IsLoading 을 켠다) -->
            <Border x:Name="LoadingIndicator"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Width="76" Height="76" CornerRadius="38"
                    Background="#99000000"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" ToolTip="불러오는 중">
                <Grid Width="44" Height="44">
                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="4" />
                    <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          Data="M 22,2 A 20,20 0 0 1 42,22">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <!-- 보일 때만 회전 애니메이션을 돌린다 -->
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Border>
        </Grid>

        <!-- 상단 바: 직접 그린 타이틀바 + 아이콘 메뉴바. 이미지 위에 반투명하게 겹쳐 표시한다. -->
        <Border x:Name="TopBar" VerticalAlignment="Top"
                Background="#E61B1B1E" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTopBarMouseLeftButtonDown"
                MouseRightButtonUp="OnTopBarMouseRightButtonUp">
            <StackPanel>
                <!-- 타이틀바: 앱 아이콘 · 파일명과 앱 이름 · 창 버튼 -->
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/ImageViewer.ico" Width="16" Height="16" Margin="12,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" Foreground="#FFD8D8D8" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="최소화" Click="OnMinimizeClick" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="최대화" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="닫기 (Esc)" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <!-- 메뉴바: 파일은 왼쪽, 나머지 메뉴는 오른쪽 정렬, 오른쪽 끝에 상단 바 고정(Pin) -->
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Menu x:Name="TopMenu" Padding="6,0,4,4" Background="Transparent"
                          ItemContainerStyle="{StaticResource TopMenuItemStyle}">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>
                        <MenuItem Header="파일(_F)" Tag="&#xE8B7;" Grid.Column="0">
                            <MenuItem Header="폴더 열기(_D)..." InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
                            <MenuItem Header="파일 / ZIP 열기(_O)..." InputGestureText="Ctrl+O" Command="{Binding OpenFileCommand}" />
                            <Separator />
                            <MenuItem Header="이미지 목록(_L)" InputGestureText="Enter" Command="{Binding ShowImageListCommand}" />
                            <Separator />
                            <MenuItem Header="종료(_X)" InputGestureText="Esc" Command="{Binding ExitCommand}" />
                        </MenuItem>

                        <MenuItem Header="보기(_V)" Tag="&#xE890;" Grid.Column="2">
                            <MenuItem Header="원본 크기(_O)" InputGestureText="0"
                                      Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.Original}"
                                      IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Original}" />
                            <MenuItem Header="폭 맞춤(_W)" InputGestureText="7"
                                      Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.FitWidth}"
                                      IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FitWidth}" />
                            <MenuItem Header="높이 맞춤(_H)" InputGestureText="8"
                                      Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.FitHeight}"
                                      IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=FitHeight}" />
                            <MenuItem Header="꽉 차게 보기(_F)" InputGestureText="9"
                                      Command="{Binding SetDisplayModeCommand}" CommandParameter="{x:Static models:DisplayMode.Fill}"
                                      IsChecked="{Binding DisplayMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Fill}" />
                            <Separator />
                            <MenuItem Header="확대(_I)" InputGestureText="+" Command="{Binding ZoomInCommand}" />
                            <MenuItem Header="축소(_U)" InputGestureText="-" Command="{Binding ZoomOutCommand}" />
                            <MenuItem Header="배율 초기화(_R)" InputGestureText="Ctrl+0" Command="{Binding ResetZoomCommand}" />
                            <Separator />
                            <MenuItem Header="시계 방향 회전" InputGestureText="R" Command="{Binding RotateClockwiseCommand}" />
                            <MenuItem Header="반시계 방향 회전" InputGestureText="L" Command="{Binding RotateCounterClockwiseCommand}" />
                            <MenuItem Header="좌우 반전" InputGestureText="H" Command="{Binding FlipHorizontalCommand}" />
                            <MenuItem Header="상하 반전" InputGestureText="V" Command="{Binding FlipVerticalCommand}" />
                            <MenuItem Header="회전 · 반전 초기화" Command="{Binding ResetTransformCommand}" />
                            <Separator />
                            <MenuItem Header="이전 페이지" InputGestureText="PgUp" Command="{Binding PreviousPageCommand}" />
                            <MenuItem Header="다음 페이지" InputGestureText="PgDn" Command="{Binding NextPageCommand}" />
                            <MenuItem Header="애니메이션 재생 (GIF / WebP)" Command="{Binding TogglePlayAnimationsCommand}"
                                      IsChecked="{Binding PlayAnimations, Mode=OneWay}" />
                            <MenuItem Header="이미지 정보" InputGestureText="Tab" Command="{Binding ToggleInfoPanelCommand}"
                                      IsChecked="{Binding IsInfoPanelVisible, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Header="상단 · 하단 바 고정(_M)" InputGestureText="`" Command="{Binding ToggleMenusCommand}"
                                      IsChecked="{Binding BothBarsPinned, Mode=OneWay}" />
                            <MenuItem Header="상단 바 고정(_A)" Command="{Binding ToggleTopBarPinCommand}"
                              IsChecked="{Binding TopBarPinned, Mode=OneWay}" />
                    <MenuItem Header="하단 바 고정(_P)" Command="{Binding ToggleBottomBarPinCommand}"
                                      IsChecked="{Binding BottomBarPinned, Mode=OneWay}" />
                            <MenuItem Header="썸네일 표시(_T)" IsCheckable="True" IsChecked="{Binding ThumbnailsVisible}" />
                            <Separator />
                            <MenuItem Header="전체 화면(_U)" InputGestureText="Alt+Enter" Command="{Binding ToggleFullScreenCommand}"
                                      IsChecked="{Binding IsFullScreen, Mode=OneWay}" />
                        </MenuItem>

                        <MenuItem Header="필터(_T)" Tag="&#xE790;" Grid.Column="3">
                            <MenuItem Header="필터 없음(_N)" InputGestureText="U"
                                      Command="{Binding SetFilterCommand}" CommandParameter="{x:Static models:ImageFilter.None}"
                                      IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                            <MenuItem Header="부드럽게(_S)" InputGestureText="I"
                                      Command="{Binding SetFilterCommand}" CommandParameter="{x:Static models:ImageFilter.Smooth}"
                                      IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Smooth}" />
                            <MenuItem Header="부드럽게 + 선명하게(_A)" InputGestureText="S"
                                      Command="{Binding SetFilterCommand}" CommandParameter="{x:Static models:ImageFilter.SmoothSharpen}"
                                      IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=SmoothSharpen}" />
                        </MenuItem>

                        <MenuItem Header="슬라이드쇼(_S)" Tag="&#xE786;" Grid.Column="4">
                            <MenuItem Header="재생 / 일시정지(_P)" InputGestureText="Space" Command="{Binding ToggleSlideShowCommand}"
                                      IsChecked="{Binding IsSlideShowPlaying, Mode=OneWay}" />
                            <Separator />
                            <MenuItem StaysOpenOnClick="True" Focusable="False">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="간격" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Width="160" Minimum="5" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                                                Value="{Binding SlideShowInterval}" />
                                        <TextBlock Text="{Binding SlideShowIntervalText}" Width="36" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" TextAlignment="Right" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="순차 재생(_Q)"
                                      Command="{Binding SetSlideShowModeCommand}" CommandParameter="{x:Static models:SlideShowMode.Sequential}"
                                      IsChecked="{Binding SlideShowMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Sequential}" />
                            <MenuItem Header="랜덤 재생(_R)"
                                      Command="{Binding SetSlideShowModeCommand}" CommandParameter="{x:Static models:SlideShowMode.Random}"
                                      IsChecked="{Binding SlideShowMode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Random}" />
                            <Separator />
                            <MenuItem Header="끝나면 처음부터 반복(_L)" IsCheckable="True" IsChecked="{Binding SlideShowRepeat}" />
                        </MenuItem>

                        <MenuItem Header="설정(_O)" Tag="&#xE713;" Grid.Column="5">
                            <MenuItem Header="설정(_S)..." Command="{Binding ShowSettingsCommand}" />
                            <Separator />
                            <MenuItem Header="단축키 안내(_K)" Click="OnShowShortcuts" />
                        </MenuItem>
                    </Menu>
                    <ToggleButton Grid.Column="1" Style="{StaticResource PinToggleButton}" Margin="0,0,10,4"
                                  IsChecked="{Binding TopBarPinned}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 하단 버블 바: 이미지 위에 떠 있는 반투명 패널 -->
        <Border x:Name="BottomBar"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,14"
                Background="#D0202022" BorderBrush="#30FFFFFF" BorderThickness="1"
                CornerRadius="14" Padding="10,6,10,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <!-- 확대·축소 | 파일 위치(가운데) | 슬라이드쇼 · 고정 핀
                     양쪽 열을 같은 너비로 맞춰 가운데 그룹이 정확히 가운데에 오게 한다. -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BottomBarSide" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BottomBarSide" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="축소 (-)" Command="{Binding ZoomOutCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="배율 초기화 (Ctrl+0)" Command="{Binding ResetZoomCommand}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="확대 (+)" Command="{Binding ZoomInCommand}" />
                        <Rectangle Width="1" Fill="{StaticResource PanelBorder}" Margin="6,5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="이전 이미지 (←)" Command="{Binding PreviousCommand}" />
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding PositionText}" MinWidth="64" TextAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="다음 이미지 (→)" Command="{Binding NextCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Rectangle Width="1" Fill="{StaticResource PanelBorder}" Margin="6,5" />
                        <Button Style="{StaticResource IconButton}" Content="{Binding SlideShowButtonText}"
                                ToolTip="슬라이드쇼 재생 / 일시정지 (Space)" Command="{Binding ToggleSlideShowCommand}" />
                        <Slider Width="110" Minimum="5" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                SmallChange="1" LargeChange="5" VerticalAlignment="Center" Margin="4,0"
                                Focusable="False" ToolTip="슬라이드쇼 간격 (5~90초)"
                                Value="{Binding SlideShowInterval}" />
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding SlideShowIntervalText}" Width="32" TextAlignment="Right" />
                        <Rectangle Width="1" Fill="{StaticResource PanelBorder}" Margin="6,5" />
                        <ToggleButton Style="{StaticResource PinToggleButton}" IsChecked="{Binding BottomBarPinned}" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="ThumbnailList"
                         Margin="0,6,0,0"
                         Visibility="{Binding ThumbnailsVisible, Converter={StaticResource BoolToVisibility}}"
                         ItemsSource="{Binding ThumbnailItems}"
                         SelectedIndex="{Binding ThumbnailSelectedIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ThumbnailItemStyle}"
                         Focusable="False"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="2"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         PreviewMouseWheel="OnThumbnailMouseWheel"
                         PreviewMouseLeftButtonDown="OnThumbnailMouseLeftButtonDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThumbnailItemViewModel}">
                            <Grid Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ToolTip="{Binding ToolTip}">
                                <TextBlock Text="{Binding Name}" Foreground="#FF808080" FontSize="10"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource InverseBoolToVisibility}}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="4" />
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
