<Application x:Class="ImageViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ImageViewer.Helpers"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:EnumEqualsConverter x:Key="EnumEquals" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <helpers:InverseBoolConverter x:Key="InverseBool" />
            <helpers:BackgroundToBrushConverter x:Key="BackgroundToBrush" />
            <helpers:BackgroundToForegroundConverter x:Key="BackgroundToForeground" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
