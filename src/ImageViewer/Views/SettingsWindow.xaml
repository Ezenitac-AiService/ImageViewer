<Window x:Class="ImageViewer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ImageViewer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="설정"
        Icon="/Resources/ImageViewer.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <GroupBox Header="표시">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="배경" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BackgroundOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Background}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="마우스 휠" Margin="0,6,8,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding MouseWheelOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MouseWheel}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="탐색 · 슬라이드쇼">
            <StackPanel>
                <CheckBox Content="처음과 마지막 이미지를 연결해 순환 탐색" IsChecked="{Binding WrapAround}" />
                <CheckBox Content="폴더 변경(추가 · 삭제 · 수정)을 감시해 목록 자동 갱신" IsChecked="{Binding WatchFolder}" />
                <CheckBox Content="슬라이드쇼가 끝나면 처음부터 반복" IsChecked="{Binding SlideShowRepeat}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="썸네일">
            <StackPanel>
                <CheckBox Content="하단 썸네일 목록 표시" IsChecked="{Binding ThumbnailVisible}" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Label}" Text="크기" Width="112" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ThumbnailSize, StringFormat={}{0} px}" Width="50"
                               TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider Minimum="48" Maximum="256" TickFrequency="8" IsSnapToTickEnabled="True"
                            Value="{Binding ThumbnailSize}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="필터 강도">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="부드럽게 (sigma)" />
                <Slider Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding SmoothSigma}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding SmoothSigma, StringFormat={}{0:0.0}}" TextAlignment="Right" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="선명하게 (sigma)" Margin="0,6,8,0" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding SharpenSigma}" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SharpenSigma, StringFormat={}{0:0.0}}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0" />

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="선명하게 (양)" Margin="0,6,8,0" />
                <Slider Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding SharpenAmount}" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SharpenAmount, StringFormat={}{0:0.0}}" TextAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Header="안전 한도">
            <DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="최대 이미지 크기" Width="112" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding MaxImageMegapixels, StringFormat={}{0} MP}" Width="60"
                           TextAlignment="Right" VerticalAlignment="Center" />
                <Slider Minimum="10" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding MaxImageMegapixels}" VerticalAlignment="Center" />
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Windows 탐색기 연동">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#FF555555">
                    폴더와 ZIP 파일의 우클릭 메뉴에 'ImageViewer에서 보기'를 추가합니다.
                    Windows 11 에서는 '추가 옵션 표시'(Shift+F10) 메뉴에 나타납니다.
                </TextBlock>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="제거" Width="70" Command="{Binding UnregisterShellCommand}" />
                    <Button DockPanel.Dock="Right" Content="등록" Width="70" Margin="0,0,6,0" Command="{Binding RegisterShellCommand}" />
                    <TextBlock Text="{Binding ShellStatusText}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="확인" Width="84" Height="28" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
            <Button Content="취소" Width="84" Height="28" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
